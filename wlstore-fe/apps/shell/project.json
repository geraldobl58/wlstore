{
  "name": "shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/shell",
  "projectType": "application",
  "tags": ["type:app", "scope:shell"],
  "// targets": "to see all targets run: nx show project shell --web",
  "// dependsOn": "o shell é o host: garantimos que o microfrontend catalog-mfe suba junto",
  "targets": {
    "dev": {
      "options": {
        "command": "next dev --port 3000"
      },
      "dependsOn": [{ "projects": ["catalog-mfe"], "target": "dev" }]
    },
    "start": {
      "options": {
        "command": "next start --port 3000"
      }
    },
    "serve-static": {
      "options": {
        "command": "next start --port 3000"
      }
    }
  }
}
