{
  "name": "vitrine-mfe",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/vitrine-mfe",
  "projectType": "application",
  "tags": ["type:app", "scope:vitrine-mfe"],
  "// targets": "to see all targets run: nx show project vitrine-mfe --web",
  "// dependsOn": "só conveniência de dev: a vitrine atende localhost:3000 e encaminha /painel, então o painel sobe junto no nx dev. Não existe dependência de build entre os apps.",
  "targets": {
    "dev": {
      "options": {
        "command": "next dev --port 3000"
      },
      "dependsOn": [{ "projects": ["painel-mfe"], "target": "dev" }]
    },
    "start": {
      "options": {
        "command": "next start --port 3000"
      }
    },
    "serve-static": {
      "options": {
        "command": "next start --port 3000"
      }
    },
    "test": {
      "command": "vitest run",
      "options": { "cwd": "apps/vitrine-mfe" }
    }
  }
}
